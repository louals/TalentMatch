# =================================================================
# TalentMatch - Environment Configuration Example
# =================================================================
# Instructions:
# 1. Copy this file: cp .env.example .env (and inside backend/ if running locally)
# 2. Replace the placeholder values with your real credentials.
# 3. NEVER commit your actual .env file to Git or push to GitHub.
# =================================================================

# -----------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -----------------------------------------------------------------
# PostgreSQL Docker & Service Credentials
POSTGRES_USER=username
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=JobMatchingDB

# PostgreSQL Connection String (Relational Database: Users, Job Offers, Applications)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
# For Docker Compose setup, use host 'postgres'. For local standalone execution, use 'localhost'.
POSTGRESQL_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# MongoDB (Document Database: Unstructured Resumes, Extracted CV data, Matches)
# Format: mongodb://<username>:<password>@<host>:<port>/<database_name>
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://mongodb:27017/JobMatchingDB

# -----------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT)
# -----------------------------------------------------------------
# Secret key used for signing session cookies and JWT access tokens
# Generate a new random secret with: openssl rand -hex 32
SECRET_KEY=your_random_secret_key_here

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------
# 3. AI / LLM SERVICES (OpenAI)
# -----------------------------------------------------------------
# Required for CV parsing, semantic matching engine, and cover letter generation
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# -----------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Social Login)
# -----------------------------------------------------------------
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# -----------------------------------------------------------------
# 5. FRONTEND & MOBILE API ENDPOINTS (Optional overrides)
# -----------------------------------------------------------------
# Base URL for API requests (defaults to http://localhost:8000 or your hosted API)
VITE_API_BASE_URL=http://localhost:8000